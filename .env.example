PORT=3000
JWT_SECRET=change-me-in-production

# Shared LMS state gateway (optional — see SETUP.md)
# SDC_STATE_SECRET=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# Local development never reaches the live Supabase project: the server serves cloud-off config
# unless SUPABASE_URL names a different (test) project. SDC_ALLOW_LIVE=1 overrides (not recommended).
# SDC_ALLOW_LIVE=
# SDC_MCP=1   # Course Builder connector for ChatGPT and Claude at /mcp (needs SDC_STATE_SECRET; see SETUP.md 5d)

# SDC Learn AI — server-only secrets (never put these in the browser DB)
# SDC_AI_SECRETS_KEY=   # defaults to SDC_STATE_SECRET or JWT_SECRET
# SDC_AI_LOCAL_OPEN=1   # when SDC_STATE_SECRET is set, local AI minting is OFF unless this is 1
# SDC_AI_MOCK=1         # demo mode for the AI course generator when no provider is set: answers with a labelled
#                       # sample outline (NOT AI). Developer machines only; ignored on Vercel / NODE_ENV=production.

# Provider keys (optional if configured via Settings → Integrations UI)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# GEMINI_API_KEY=
# Gemini 2.5 models are only open to projects that already used them; new keys use 3.5 Flash-Lite or 3.8 Flash.
# GEMINI_MODEL=gemini-3.5-flash-lite

# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# GROQ_API_KEY=
# No default model: choose one from Groq's list (Settings → Integrations → Groq → Load models from Groq).
# GROQ_MODEL=
# YOUTUBE_API_KEY=                                   # YouTube Data API v3 key: videos for AI-generated sessions (or set it in Settings → Integrations)
# SDC_QA_YOUTUBE_BASE_URL=http://127.0.0.1:54399/youtube/v3   # QA only: a YouTube stand-in on this machine
# SDC_QA_GROQ_BASE_URL=http://127.0.0.1:54398/v1   # QA only: a Groq stand-in on this machine (loopback only; ignored on Vercel / production)
# SDC_QA_GEMINI_BASE_URL=http://127.0.0.1:54398/v1beta   # QA only: a Gemini stand-in, same rules
# SDC_AI_CONTENT_RATE=300   # AI requests per person per hour for course outline, content and repair (default 300, never below 60); other AI features stay at 60

UPLOAD_MAX_MB=30
# UPLOAD_ALLOWED_TYPES=xlsx,xls,csv,docx,pptx,pdf,pbix,twbx,ipynb,sql,txt,zip
