# Local development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Legacy passkey endpoints only (not used by the current UI).
# Example:
# PUBLIC_URL=https://your-service.onrender.com
# WEBAUTHN_RP_ID=your-service.onrender.com
# WEBAUTHN_ORIGIN=https://your-service.onrender.com
# If PUBLIC_URL is omitted, the server derives the HTTPS origin from the request.
PUBLIC_URL=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Neon PostgreSQL (optional: persists the server's own state file, not LMS data)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Uploads (server-side validation for /api/lms/uploads)
UPLOAD_MAX_MB=30
UPLOAD_ALLOWED_TYPES=xlsx,xls,xlsm,csv,docx,doc,pptx,ppt,pdf,pbix,twbx,twb,ipynb,sql,txt,md,zip,png,jpg,jpeg,webp,svg,mp4
