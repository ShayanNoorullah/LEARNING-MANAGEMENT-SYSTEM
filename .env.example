# Local development
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# Production: set these in your hosting provider after you know the public URL.
# Example:
# PUBLIC_URL=https://your-service.onrender.com
# WEBAUTHN_RP_ID=your-service.onrender.com
# WEBAUTHN_ORIGIN=https://your-service.onrender.com
# If PUBLIC_URL is omitted, the server derives the HTTPS origin from the request.
PUBLIC_URL=
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Neon PostgreSQL (optional persistent POC/production state store)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
