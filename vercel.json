{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/data/database.json",
      "maxDuration": 15
    }
  },
  "routes": [
    { "src": "/backend/.*", "status": 404 },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/uploads/(.*)", "dest": "/api/index.js" }
  ]
}
